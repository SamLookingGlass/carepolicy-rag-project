# ---------------------------------------------------------------------------
# LLM provider
# auto   = use OpenAI if OPENAI_API_KEY is set, else local
# openai = force OpenAI direct API
# local  = no cloud LLM (extractive answers only; local embeddings)
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto

# OpenAI direct API — recommended for testing
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=carepolicy-rag

# Qdrant — use local mode when Docker is unavailable
QDRANT_MODE=local
QDRANT_PATH=data/index/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=carepolicy_chunks

# Retrieval tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
RERANK_SCORE_THRESHOLD=0.25

# API — shared secret for POST /query (Swagger "Authorize" / X-API-Key header)
# Generate a new one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
API_KEY=carepolicy-demo-OMpV3kCmzqcsr7v2w-8dNg
