# auto = OpenAI if OPENAI_API_KEY is set, else Azure, else local extractive fallback
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=carepolicy-rag

QDRANT_MODE=local
QDRANT_PATH=data/index/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=carepolicy_chunks

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
RERANK_SCORE_THRESHOLD=0.25

AGENT_MAX_MODEL_TURNS=4
AGENT_MAX_TOOL_CALLS=6
MULTI_MAX_RETRIES=1
MULTI_MAX_STEPS=12

# Protects POST /query (X-API-Key). This is not your OpenAI key.
# python -c "import secrets; print(secrets.token_urlsafe(16))"
API_KEY=dev-key-change-me

# Optional: faster reranker downloads
# HF_TOKEN=
